# Menetapkan AIRFLOW_UID adalah cara kita "menyamakan frekuensi" identitas 
# antara komputer fisik kita dengan sistem di dalam Docker, 
# agar tidak ada drama perebutan hak milik file selama kamu mendevelop DAG Airflow.

AIRFLOW_UID=1000

# username dan password default airflow webserver adalah: airflow dan airflow